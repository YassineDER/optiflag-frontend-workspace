{
  "name": "optiflag-frontend-workspace",
  "version": "1.0.0",
  "description": "Feature management platform in real-time",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev:web": "pnpm --filter @optiflag/web dev",
    "dev:admin": "pnpm --filter @optiflag/admin dev",
    "start": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "clean": "turbo clean",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "author": "Yassine DERGAOUI",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "turbo": "^2.10.9",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
